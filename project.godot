config_version=5

[application]

config/name="Cardinal Conflict"
config/description="A local hot-seat territory strategy game for 2-8 players."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.5", "C#", "GL Compatibility")
config/icon="res://icon.png"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=2

[dotnet]

project/assembly_name="CardinalConflict"

